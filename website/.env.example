# talak-web3 website
# Copy this file to `.env.local` and fill in real values.
# Do NOT commit real secrets.

# Supabase project — required for auth, profiles, blog, projects, and webhooks.
# Find these in Supabase dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TALAK_API_BASE_URL=http://localhost:8787


# Optional - ETH address that receives crypto checkout payments on /pricing.
# Falls back to a deterministic dev placeholder if unset.
VITE_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

SIWE_DOMAIN=localhost:8787

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

TRUSTED_PROXY_RANGES=

REDIS_URL=redis://localhost:6379

# GitHub OAuth — powers the real "Connect GitHub" flow on the Hono backend.
# The client secret never leaves the server. GITHUB_OAUTH_REDIRECT_URI must be a
# public URL GitHub can reach (e.g. https://api.yourdomain.com/integrations/github/callback).
# GITHUB_OAUTH_STATE_SECRET is used to sign/verify the OAuth `state` param.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
GITHUB_OAUTH_STATE_SECRET=

# Supabase REST (anon/publishable key) — lets the backend persist the GitHub
# connection through the SECURITY DEFINER function `complete_github_connect`.
SUPABASE_URL=
SUPABASE_ANON_KEY=

{
  "name": "@talak-web3/dashboard",
  "version": "1.1.0",
  "description": "Admin dashboard components for talak-web3",
  "homepage": "https://github.com/dagimabebe/talak-web3/tree/main/packages/dashboard#readme",
  "bugs": {
    "url": "https://github.com/dagimabebe/talak-web3/issues"
  },
  "license": "MIT",
  "author": "Dagim Abebe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dagimabebe/talak-web3.git",
    "directory": "packages/dashboard"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/index.react.d.ts",
      "default": "./dist/index.react.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "pnpm rimraf dist",
    "lint:package": "publint run --strict --pack false",
    "lint:types": "attw --profile esm-only --pack ."
  },
  "dependencies": {
    "@talak-web3/hooks": "workspace:*",
    "@talak-web3/types": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "experimental": true
}
